# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# Optional DNS resolvers for MongoDB Atlas SRV records (comma-separated)
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# File storage
FILE_STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Scheduler
SCHEDULER_API_KEY=replace-with-a-long-random-secret

# Do not keep bootstrap credentials in this file. Provide these only when
# executing `npm run seed:admin`.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=System Admin
# BOOTSTRAP_ADMIN_PHONE=0000000000

# One-time migration for employees that existed before General Managers.
# Set this only when executing `npm run migrate:employees-to-gm`.
# MIGRATION_GENERAL_MANAGER_EMAIL=
