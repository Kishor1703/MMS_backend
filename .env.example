# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/machine_maintenance

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000

# File Storage
FILE_STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Cloudinary (only used if FILE_STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret so the Python scheduler can call protected internal endpoints
SCHEDULER_API_KEY=change_this_to_a_long_random_secret_too
